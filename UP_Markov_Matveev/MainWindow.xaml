<Window x:Class="UP_Markov_Matveev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Логистическая компания — УП.01.01"
        Height="650" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <Button x:Name="ButtonBack"
                    Content="← Назад"
                    HorizontalAlignment="Left"
                    Width="100"
                    Margin="8,4"
                    Click="ButtonBack_Click"/>
            <TextBlock Text="Проектирование и разработка БД для логистической компании"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button x:Name="ButtonTheme"
                    Content="Сменить тему"
                    HorizontalAlignment="Right"
                    Width="130"
                    Margin="8,4"
                    Click="ButtonTheme_Click"/>
        </Grid>

       
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"/>

        
        <Grid Grid.Row="2" Background="{DynamicResource PanelBrush}">
            <TextBlock x:Name="DateTimeNow"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
        </Grid>
    </Grid>
</Window>
