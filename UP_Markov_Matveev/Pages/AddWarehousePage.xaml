<Page x:Class="UP_Markov_Matveev.Pages.AddWarehousePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Склад">

    <Grid Margin="24" HorizontalAlignment="Center" Width="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Карточка склада" FontSize="16pt" FontWeight="Bold" Margin="0,0,0,12"/>

        <Label Grid.Row="1" Content="Название"/>
        <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="2" Content="Город"/>
        <ComboBox Grid.Row="2" x:Name="CBCity" SelectedValuePath="CityId"
                  SelectedValue="{Binding CityId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="3" Content="Адрес"/>
        <TextBox Grid.Row="3" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="4" Content="Вместимость, т"/>
        <TextBox Grid.Row="4" Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonCancel" Content="Отмена" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
