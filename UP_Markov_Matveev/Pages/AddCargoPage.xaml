<Page x:Class="UP_Markov_Matveev.Pages.AddCargoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Груз">

    <Grid Margin="24" HorizontalAlignment="Center" Width="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Карточка груза" FontSize="16pt" FontWeight="Bold" Margin="0,0,0,12"/>

        <Label Grid.Row="1" Content="Заказ"/>
        <ComboBox Grid.Row="1" x:Name="CBOrder" SelectedValuePath="OrderId"
                  SelectedValue="{Binding OrderId}" DisplayMemberPath="DisplayLabel"
                  HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="2" Content="Тип груза"/>
        <ComboBox Grid.Row="2" x:Name="CBCargoType" SelectedValuePath="CargoTypeId"
                  SelectedValue="{Binding CargoTypeId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="3" Content="Наименование"/>
        <TextBox Grid.Row="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="4" Content="Вес, кг"/>
        <TextBox Grid.Row="4" Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="5" Content="Объём, м³"/>
        <TextBox Grid.Row="5" Text="{Binding VolumeM3, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonCancel" Content="Отмена" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
