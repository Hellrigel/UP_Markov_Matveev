<Page x:Class="UP_Markov_Matveev.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid>
        <Border Width="420"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                CornerRadius="8">
            <StackPanel>

                <TextBlock Text="Вход в систему"
                           FontSize="18pt"
                           FontWeight="Bold"
                           Margin="0,0,0,16"
                           HorizontalAlignment="Center"/>

                
                <StackPanel x:Name="LoginPanel">
                    <Label x:Name="labelLogin" Content="Логин"/>
                    <TextBox x:Name="TextBoxLogin"
                             ToolTip="Введите логин или почту"
                             TextChanged="TextBoxLogin_TextChanged"/>

                    <Label x:Name="labelPass" Content="Пароль"/>
                    <PasswordBox x:Name="PasswordBox"
                                 ToolTip="Введите пароль"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <Button x:Name="ButtonEnter"
                            Content="Вход"
                            ToolTip="Кнопка входа"
                            Click="ButtonEnter_OnClick"/>
                    <Button x:Name="ButtonReg"
                            Content="Регистрация"
                            ToolTip="Кнопка регистрации"
                            Click="ButtonReg_Click"/>
                    <Button x:Name="ButtonChangePassword"
                            Content="Смена пароля"
                            ToolTip="Кнопка смены пароля"
                            Click="ButtonChangePassword_Click"/>
                </StackPanel>

                <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed">
                    <TextBlock Text="Слишком много неверных попыток. Введите символы с картинки:"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Label Name="labelCaptcha" Content="Капча:"/>
                    <TextBox x:Name="captcha"
                             CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                             ContextMenu="{x:Null}"
                             Foreground="{DynamicResource DangerBrush}"
                             FontStyle="Italic"
                             FontWeight="Bold"
                             FontStretch="UltraCondensed"
                             IsReadOnly="True"
                             HorizontalContentAlignment="Center"
                             FontSize="22"/>
                    <TextBox x:Name="captchaInput"
                             ToolTip="Введите символы с картинки выше"/>
                    <Button x:Name="submitCaptcha"
                            Content="Подтвердить"
                            ToolTip="Подтвердить ввод капчи"
                            Click="submitCaptcha_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
