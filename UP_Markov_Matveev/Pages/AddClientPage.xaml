<Page x:Class="UP_Markov_Matveev.Pages.AddClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Клиент">

    <Grid Margin="24" HorizontalAlignment="Center" Width="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Карточка клиента" FontSize="16pt" FontWeight="Bold" Margin="0,0,0,12"/>

        <Label Grid.Row="1" Content="Имя / организация"/>
        <TextBox Grid.Row="1" x:Name="TBName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="2" Content="Тип клиента"/>
        <ComboBox Grid.Row="2" x:Name="CBClientType" SelectedValuePath="ClientTypeId"
                  SelectedValue="{Binding ClientTypeId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="3" Content="Город"/>
        <ComboBox Grid.Row="3" x:Name="CBCity" SelectedValuePath="CityId"
                  SelectedValue="{Binding CityId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="4" Content="Телефон"/>
        <TextBox Grid.Row="4" x:Name="TBPhone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="5" Content="E-mail"/>
        <TextBox Grid.Row="5" x:Name="TBEmail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <Label Grid.Row="6" Content="Адрес"/>
        <TextBox Grid.Row="6" x:Name="TBAddress" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="300"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonCancel" Content="Отмена" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
