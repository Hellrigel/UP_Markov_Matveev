<Page x:Class="UP_Markov_Matveev.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">

    <Grid>
        <Border Width="420"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Смена пароля"
                           FontSize="16pt"
                           FontWeight="Bold"
                           Margin="0,0,0,16"
                           HorizontalAlignment="Center"/>

                <Label Content="Логин"/>
                <TextBox x:Name="TbLogin" ToolTip="Введите логин"/>

                <Label Content="Текущий пароль"/>
                <PasswordBox x:Name="CurrentPasswordBox" ToolTip="Введите текущий пароль"/>

                <Label Content="Новый пароль"/>
                <PasswordBox x:Name="NewPasswordBox" ToolTip="Введите новый пароль"/>

                <Label Content="Подтверждение нового пароля"/>
                <PasswordBox x:Name="ConfirmPasswordBox" ToolTip="Повторите новый пароль"/>

                <Button x:Name="ButtonSave" Content="Сохранить" Click="ButtonSave_Click"/>
                <Button x:Name="ButtonCancel" Content="Назад ко входу" Click="ButtonCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
