<Page x:Class="UP_Markov_Matveev.Pages.AddOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказ">

    <Grid Margin="24" HorizontalAlignment="Center" Width="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Карточка заказа" FontSize="16pt" FontWeight="Bold" Margin="0,0,0,12"/>

        <Label Grid.Row="1" Content="Клиент"/>
        <ComboBox Grid.Row="1" x:Name="CBClient" SelectedValuePath="ClientId"
                  SelectedValue="{Binding ClientId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="2" Content="Склад (необязательно)"/>
        <ComboBox Grid.Row="2" x:Name="CBWarehouse" SelectedValuePath="WarehouseId"
                  SelectedValue="{Binding WarehouseId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="3" Content="Статус"/>
        <ComboBox Grid.Row="3" x:Name="CBStatus" SelectedValuePath="OrderStatusId"
                  SelectedValue="{Binding OrderStatusId}" DisplayMemberPath="Name"
                  HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="4" Content="Адрес отправления"/>
        <TextBox Grid.Row="4" Text="{Binding PickupAddress, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="5" Content="Адрес доставки"/>
        <TextBox Grid.Row="5" Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="6" Content="Дата заказа"/>
        <DatePicker Grid.Row="6" x:Name="DPOrderDate" SelectedDate="{Binding OrderDate}" HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="7" Content="Плановая дата доставки"/>
        <DatePicker Grid.Row="7" x:Name="DPPlannedDate" SelectedDate="{Binding PlannedDate}" HorizontalAlignment="Right" Width="340"/>

        <Label Grid.Row="8" Content="Стоимость, руб."/>
        <TextBox Grid.Row="8" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="340"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ButtonSave" Content="Сохранить" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonCancel" Content="Отмена" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Page>
